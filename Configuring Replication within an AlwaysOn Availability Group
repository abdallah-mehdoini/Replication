-- SECTION 7 ---- ***CONFIGURE THE REDIRECT PUBLISHER***
-- on paimary distributor replicas BFRDT1CLU069VM\REPLI, 
-- add publisher redirect by using publsher database ag listener TraceabilityPubDist
:CONNECT Distributor A
USE distribution
GO
 
EXEC sys.sp_redirect_publisher
@original_publisher = 'BFRDT1CLU070VM\ARIANEREP',
@publisher_db = 'ARIANEREP',
